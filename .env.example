# Root-level .env -- read only by ai/dataset/download_from_roboflow.py
# (via python-dotenv, loading <project root>/.env). This is separate from
# backend/.env, which the FastAPI app reads instead -- see
# backend/.env.example for that one.
#
#   cp .env.example .env
#
# Get a free key at https://roboflow.com/settings/api -- Universe
# datasets are public but still require your own key to download.
ROBOFLOW_API_KEY=your_key_here
