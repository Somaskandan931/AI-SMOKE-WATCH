# yolo_service.py and plate_detector.py auto-detect real weight files under
# ai/weights/ (best.pt/last.pt, else vehicle_yolov8n.pt+smoke_yolov8s.pt,
# else plate_best.pt) via config.py -- you do NOT need to set anything below
# for the shipped weights to be picked up.

# Override only the plate weights path/filename (plate_detector.py honors
# this). There is no equivalent override for the vehicle/smoke weights --
# config.py's unified/two-model filenames are fixed.
# PLATE_WEIGHTS_PATH=../ai/weights/plate_best.pt

SMOKE_CONFIDENCE_THRESHOLD=0.5
VEHICLE_CONFIDENCE_THRESHOLD=0.5

# Read by report_service.py (the "@handle" pre-tagged in the generated
# report / X intent link). Note: config.py separately defines an unused
# CIVIC_AUTHORITY_HANDLE with the same default -- dead code, safe to
# ignore; this AUTHORITY_HANDLE is the one that actually takes effect.
AUTHORITY_HANDLE=@ChennaiTrafficP

# Set to 1 to force every inference stage (vehicle/smoke, plate, OCR) into
# deterministic mock mode regardless of installed engines/weights -- what
# the test suite sets automatically (see tests/conftest.py). Leave unset
# for real inference.
# FORCE_MOCK_INFERENCE=1

# Optional -- unwired scaffold only (app/services/x_client.py is not
# imported/called anywhere; the app never auto-publishes, by PRD design --
# FR-14/FR-15 -- it only builds an X share-intent link the user completes
# themselves). Set all four to actually wire up real posting yourself.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
