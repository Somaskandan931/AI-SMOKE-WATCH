# ---------- Python ----------
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# ---------- IDE / OS ----------
.idea/
.vscode/
.DS_Store
__MACOSX/
*.iml

# ---------- Env / secrets (keep .env.example) ----------
.env
*.log

# ---------- Flutter / Android ----------
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/ios/Pods/
.gradle/
.kotlin/
local.properties

# ---------- Model weights ----------
# Shipped app weights (ai/weights/vehicle_yolov8n.pt, smoke_yolov8s.pt, plate_best.pt) ARE committed.
ai/weights/best.pt
ai/weights/last.pt
# Never commit "last" checkpoints (duplicates of best.pt)
**/last.pt
# Auto-downloaded pretrained starting points (re-downloaded by Ultralytics)
ai/benchmark/pretrained/
# Faster R-CNN best.pt is 76 MB (GitHub warns >50 MB, blocks >100 MB): publish it as a GitHub Release asset
# (or track with Git LFS) instead of committing it.
ai/benchmark/runs/frcnn/*.pt
# YOLO benchmark best.pt files (6-22 MB each) ARE committed so the paper's numbers can be re-evaluated.

# ---------- Datasets ----------
# Large / reproducible downloads
ai/dataset/_roboflow_downloads/
ai/dataset/processed/images/
ai/dataset/processed/labels/
!ai/dataset/processed/README.md
ai/dataset/raw/negatives/*
!ai/dataset/raw/negatives/README.md
# Ultralytics label caches
*.cache
# External dataset dump at repo root (not used by the benchmark)
Datasets/
# COMMITTED ON PURPOSE (needed to reproduce the paper): ai/dataset/processed_smoke_only/,
# ai/dataset/processed_smoke_only_grouped/ (32 MB), ai/dataset/grouped_split_manifest.csv

# ---------- Benchmark: regenerable / machine-specific only ----------
# cached predictions (regenerated by threshold_sweep.py / evaluate_test.py; stale after retraining)
ai/benchmark/results/preds/
# absolute-path yaml written at every run
ai/benchmark/data.yaml
# COMMITTED ON PURPOSE: ai/benchmark/results/*.json, tables.md, figures/, association_*, hard_cases_*,
# ai/benchmark/runs/*/results.csv, args.yaml, curves/plots, weights/best.pt (YOLO), hard_cases/manifest.csv