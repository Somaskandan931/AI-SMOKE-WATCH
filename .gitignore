# ---------- Python ----------
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# ---------- IDE / OS ----------
.idea/
.vscode/
.DS_Store
__MACOSX/
*.iml

# ---------- Env / secrets ----------
# Keep .env.example committed
.env
*.log

# ---------- Flutter / Android ----------
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/ios/Pods/
.gradle/
.kotlin/
local.properties

# ---------- Model weights ----------
# Shipped app weights are intentionally committed.
# ai/weights/vehicle_yolov8n.pt
# ai/weights/smoke_yolov8s.pt
# ai/weights/plate_best.pt

# Ignore generic training checkpoints
ai/weights/best.pt
ai/weights/last.pt
**/last.pt

# Auto-downloaded pretrained starting points
ai/benchmark/pretrained/

# ---------- Large benchmark checkpoints ----------
# Faster R-CNN checkpoints are large and should NOT be committed.
# Use Git LFS or publish them as GitHub Release assets instead.
ai/benchmark/runs/frcnn/**/*.pt

# Explicitly ignore the known Faster R-CNN experiment directory.
ai/benchmark/runs/frcnn_prev_30ep/**/*.pt

# ---------- YOLO benchmark weights ----------
# YOLO benchmark best.pt files are intentionally committed
# because they are small enough to reproduce the paper results.
#
# Keep the explicit allow-list below for the YOLO checkpoints
# that are intentionally part of the repository.

# Example:
# !ai/benchmark/runs/yolov8n/best.pt
# !ai/benchmark/runs/yolov8s/best.pt

# ---------- Datasets ----------
# Large / reproducible downloads
ai/dataset/_roboflow_downloads/
ai/dataset/processed/images/
ai/dataset/processed/labels/

# Keep dataset documentation
!ai/dataset/processed/README.md

# Raw negative images
ai/dataset/raw/negatives/*
!ai/dataset/raw/negatives/README.md

# Ultralytics label caches
*.cache

# External dataset dump at repo root
# Not used by the benchmark
Datasets/

# COMMITTED ON PURPOSE:
# ai/dataset/processed_smoke_only/
# ai/dataset/processed_smoke_only_grouped/
# ai/dataset/grouped_split_manifest.csv

# ---------- Benchmark: regenerable / machine-specific ----------
# Cached predictions
# Regenerated by threshold_sweep.py / evaluate_test.py
ai/benchmark/results/preds/

# Absolute-path YAML written at every run
ai/benchmark/data.yaml

# ---------- Benchmark results intentionally committed ----------
# Paper/reproducibility outputs are intentionally tracked:
#
# ai/benchmark/results/*.json
# ai/benchmark/results/tables.md
# ai/benchmark/results/figures/
# ai/benchmark/results/association_*
# ai/benchmark/results/hard_cases_*
#
# Run-level reproducibility files:
# ai/benchmark/runs/*/results.csv
# ai/benchmark/runs/*/args.yaml
# ai/benchmark/runs/*/curves/
# ai/benchmark/runs/*/plots/
# ai/benchmark/runs/*/hard_cases/
# ai/benchmark/runs/*/manifest.csv

# ---------- Temporary / generated files ----------
*.tmp
*.temp
*.bak
*.swp
*.swo